{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flexspeed",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/r/*", "/og/*"],
  },
  "ratelimits": [
    {
      "name": "TEST_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flexspeed",
      "database_id": "bfa1a3db-6c80-4035-be43-bb456b6c383c",
      "migrations_dir": "migrations",
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "POSTERS",
      "bucket_name": "flexspeed-posters",
      "remote": true,
    },
  ],
}
