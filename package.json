{
  "name": "flexspeed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run --config vitest.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc -b",
    "db:migrate": "wrangler d1 migrations apply flexspeed --local",
    "db:migrate:remote": "wrangler d1 migrations apply flexspeed --remote",
    "test:smoke": "node scripts/smoke.mjs",
    "format": "prettier --write src tests scripts docs *.ts *.json *.jsonc index.html README.md pnpm-workspace.yaml",
    "format:check": "prettier --check src tests scripts docs *.ts *.json *.jsonc index.html README.md pnpm-workspace.yaml"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "better-auth": "^1.7.14",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20261030.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}
