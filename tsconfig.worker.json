{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/worker.tsbuildinfo",
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/worker", "src/shared"]
}
