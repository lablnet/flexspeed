# Copy to .dev.vars for local Google OAuth. Never commit .dev.vars.
# Use separate, securely generated random values for these two secrets.
SESSION_SECRET=replace-with-a-random-secret
BETTER_AUTH_SECRET=replace-with-a-different-random-secret-at-least-32-bytes
BETTER_AUTH_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-web-client-id
GOOGLE_CLIENT_SECRET=your-google-web-client-secret
